# 使用 CocoaPods 官方 CDN，提高 pod 安装和更新速度
source 'https://cdn.cocoapods.org/'

install! 'cocoapods', :warn_for_unused_master_specs_repo => false

platform :ios, '15.0'

target 'ZHHCarouselView_Example' do
  use_frameworks!

  pod 'ZHHCarouselView', :path => '../'

  target 'ZHHCarouselView_Tests' do
    inherit! :search_paths
  end
end
